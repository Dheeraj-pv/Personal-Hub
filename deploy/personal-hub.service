[Unit]
Description=Personal Hub (laptop sync server)
After=network.target

[Service]
EnvironmentFile=%h/.config/personal-hub/env
WorkingDirectory=%h/dev/personal-hub
ExecStart=%h/dev/personal-hub/.venv/bin/uvicorn --factory hub.main:create_app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/PersonalHub

[Install]
WantedBy=default.target
